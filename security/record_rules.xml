<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ========================================================== -->
        <!-- 1. MULTI-COMPANY RECORD RULES                              -->
        <!-- ========================================================== -->
        <record id="rule_helpdesk_ticket_comp" model="ir.rule">
            <field name="name">HelpDesk Ticket: Multi-Company</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_helpdesk_team_comp" model="ir.rule">
            <field name="name">HelpDesk Team: Multi-Company</field>
            <field name="model_id" ref="model_helpdesk_team"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_helpdesk_sla_comp" model="ir.rule">
            <field name="name">HelpDesk SLA: Multi-Company</field>
            <field name="model_id" ref="model_helpdesk_sla"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- ========================================================== -->
        <!-- 2. CUSTOMER PORTAL RECORD RULES                            -->
        <!-- ========================================================== -->
        <record id="rule_helpdesk_ticket_portal" model="ir.rule">
            <field name="name">HelpDesk Ticket: Portal User Own Tickets Only</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('partner_id', '=', user.partner_id.id),
                ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_helpdesk_kb_article_portal" model="ir.rule">
            <field name="name">HelpDesk Knowledge Article: Portal Published Only</field>
            <field name="model_id" ref="model_helpdesk_knowledge_article"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('is_published', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================================== -->
        <!-- 3. INTERNAL ROLE-BASED TICKET RECORD RULES                 -->
        <!-- ========================================================== -->
        <!-- Basic HelpDesk User: Own created, assigned, or followed tickets -->
        <record id="rule_helpdesk_ticket_basic_user" model="ir.rule">
            <field name="name">HelpDesk Ticket: Basic User Permitted Tickets</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('partner_id', '=', user.partner_id.id),
                ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
        </record>

        <!-- HelpDesk Agent & Team Leader: Assigned, Unassigned, or Team Tickets -->
        <record id="rule_helpdesk_ticket_agent_team" model="ir.rule">
            <field name="name">HelpDesk Ticket: Agent &amp; Team Leader Team Tickets</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups" eval="[(4, ref('group_helpdesk_agent')), (4, ref('group_helpdesk_leader'))]"/>
            <field name="domain_force">[
                '|', '|', '|', '|',
                ('user_id', '=', user.id),
                ('user_id', '=', False),
                ('team_id', '=', False),
                ('team_id.member_ids', 'in', [user.id]),
                ('team_id.leader_id', '=', user.id)
            ]</field>
        </record>

        <!-- HelpDesk Manager & Administrator: All Tickets -->
        <record id="rule_helpdesk_ticket_manager_all" model="ir.rule">
            <field name="name">HelpDesk Ticket: Manager &amp; Admin Full Access</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager')), (4, ref('group_helpdesk_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
