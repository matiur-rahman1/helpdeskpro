<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Printable Support Ticket Summary & Resolution PDF Report -->
    <record id="action_report_helpdesk_ticket" model="ir.actions.report">
        <field name="name">Ticket Summary &amp; Resolution Report</field>
        <field name="model">helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">helpdeskpro.report_helpdesk_ticket_document</field>
        <field name="report_file">helpdeskpro.report_helpdesk_ticket_document</field>
        <field name="print_report_name">'Ticket - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_helpdesk_ticket"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. Printable Team Performance & SLA Compliance PDF Report -->
    <record id="action_report_helpdesk_team" model="ir.actions.report">
        <field name="name">Team Performance &amp; SLA Report</field>
        <field name="model">helpdesk.team</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">helpdeskpro.report_helpdesk_team_document</field>
        <field name="report_file">helpdeskpro.report_helpdesk_team_document</field>
        <field name="print_report_name">'Team SLA Report - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_helpdesk_team"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
