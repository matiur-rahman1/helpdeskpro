<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Knowledge Articles Search -->
    <record id="view_helpdesk_kb_article_search" model="ir.ui.view">
        <field name="name">helpdesk.knowledge.article.search</field>
        <field name="model">helpdesk.knowledge.article</field>
        <field name="arch" type="xml">
            <search string="Knowledge Base Articles">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('summary', 'ilike', self), ('keywords', 'ilike', self)]" string="Article / Keywords"/>
                <field name="category_id"/>
                <field name="ticket_category_id"/>
                <filter name="filter_published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="filter_faq" string="FAQ Featured" domain="[('is_faq', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Knowledge Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_ticket_cat" string="Ticket Category" context="{'group_by': 'ticket_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Knowledge Articles Kanban -->
    <record id="view_helpdesk_kb_article_kanban" model="ir.ui.view">
        <field name="name">helpdesk.knowledge.article.kanban</field>
        <field name="model">helpdesk.knowledge.article</field>
        <field name="arch" type="xml">
            <kanban class="hdp-kb-kanban">
                <field name="name"/>
                <field name="category_id"/>
                <field name="summary"/>
                <field name="is_faq"/>
                <field name="is_published"/>
                <field name="views_count"/>
                <field name="helpful_count"/>
                <templates>
                    <t t-name="card">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge text-bg-light border text-secondary"><field name="category_id"/></span>
                                <div class="d-flex gap-1">
                                    <span t-if="record.is_faq.raw_value" class="badge text-bg-warning">FAQ</span>
                                    <span t-if="record.is_published.raw_value" class="badge text-bg-success">Published</span>
                                    <span t-else="" class="badge text-bg-secondary">Draft</span>
                                </div>
                            </div>
                            <h5 class="fw-bold text-dark mb-1"><field name="name"/></h5>
                            <p class="text-muted small mb-2"><field name="summary"/></p>
                            <div class="d-flex justify-content-between small text-muted pt-2 border-top">
                                <span><i class="fa fa-eye me-1" title="Views"/><field name="views_count"/> views</span>
                                <span><i class="fa fa-thumbs-up me-1" title="Helpful"/><field name="helpful_count"/> helpful</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Knowledge Articles List -->
    <record id="view_helpdesk_kb_article_list" model="ir.ui.view">
        <field name="name">helpdesk.knowledge.article.list</field>
        <field name="model">helpdesk.knowledge.article</field>
        <field name="arch" type="xml">
            <list string="Knowledge Base Articles">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="ticket_category_id" optional="show"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="is_faq" widget="boolean_toggle"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="views_count"/>
                <field name="helpful_count"/>
            </list>
        </field>
    </record>

    <!-- Knowledge Articles Form -->
    <record id="view_helpdesk_kb_article_form" model="ir.ui.view">
        <field name="name">helpdesk.knowledge.article.form</field>
        <field name="model">helpdesk.knowledge.article</field>
        <field name="arch" type="xml">
            <form string="Knowledge Base Article">
                <header>
                    <button name="action_toggle_publish" type="object"
                            string="Publish on Portal" class="btn-primary" invisible="is_published"/>
                    <button name="action_toggle_publish" type="object"
                            string="Unpublish" class="btn-secondary" invisible="not is_published"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not is_published"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. How to Configure Two-Factor Authentication"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="ticket_category_id"/>
                            <field name="keywords" placeholder="2fa, password, login, security"/>
                        </group>
                        <group string="Publishing &amp; Engagement">
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="is_faq"/>
                            <field name="is_published"/>
                            <field name="views_count" readonly="1"/>
                            <field name="helpful_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="summary" nolabel="1" placeholder="Brief summary displayed in search results and portal suggestion cards..."/>
                    </group>
                    <notebook>
                        <page string="Article Content" name="content">
                            <field name="content" placeholder="Write the step-by-step guide here..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_kb_article" model="ir.actions.act_window">
        <field name="name">Knowledge Articles</field>
        <field name="res_model">helpdesk.knowledge.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_helpdesk_kb_article_search"/>
    </record>

    <!-- Knowledge Categories -->
    <record id="view_helpdesk_kb_category_list" model="ir.ui.view">
        <field name="name">helpdesk.knowledge.category.list</field>
        <field name="model">helpdesk.knowledge.category</field>
        <field name="arch" type="xml">
            <list string="Knowledge Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="description"/>
                <field name="article_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_helpdesk_kb_category" model="ir.actions.act_window">
        <field name="name">Knowledge Categories</field>
        <field name="res_model">helpdesk.knowledge.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
