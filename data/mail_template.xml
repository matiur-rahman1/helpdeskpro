<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Ticket Creation Confirmation Email (to Customer) -->
        <record id="mail_template_ticket_created" model="mail.template">
            <field name="name">HelpDeskPro: Ticket Created Notification</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">[{{ object.name }}] Support Request Received: {{ object.subject }}</field>
            <field name="email_from">{{ (object.team_id.email or object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_email }}</field>
            <field name="description">Sent automatically to the customer when a new support ticket is created.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1E293B;">
                    <div style="max-width: 620px; margin: 0 auto; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
                        <div style="background-color: #1E293B; color: #FFFFFF; padding: 20px 24px;">
                            <h2 style="margin: 0; font-size: 18px;">HelpDeskPro Support Confirmation</h2>
                            <p style="margin: 4px 0 0; font-size: 13px; color: #94A3B8;">Ticket Reference: <strong t-out="object.name">HDP00001</strong></p>
                        </div>
                        <div style="padding: 24px; background-color: #FFFFFF;">
                            <p>Hello <strong t-out="object.partner_id.name or 'Valued Customer'">Customer</strong>,</p>
                            <p>Thank you for contacting our support team. Your request has been logged and assigned reference number <strong t-out="object.name">HDP00001</strong>.</p>
                            <table style="width: 100%; border-collapse: collapse; margin: 16px 0; background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;">
                                <tr>
                                    <td style="padding: 10px 14px; font-weight: 600; width: 35%;">Subject:</td>
                                    <td style="padding: 10px 14px;" t-out="object.subject">Issue Subject</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 14px; font-weight: 600;">Support Team:</td>
                                    <td style="padding: 10px 14px;" t-out="object.team_id.name or 'General Support'">Support Team</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 14px; font-weight: 600;">Priority:</td>
                                    <td style="padding: 10px 14px;" t-out="dict(object._fields['priority'].selection).get(object.priority, 'Medium')">Medium</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 14px; font-weight: 600;">Status:</td>
                                    <td style="padding: 10px 14px;" t-out="dict(object._fields['state'].selection).get(object.state, 'New')">New</td>
                                </tr>
                            </table>
                            <p>You can track the progress of your ticket and reply online from your customer portal at <a t-attf-href="/my/tickets/{{ object.id }}" style="color: #2563EB; font-weight: 600;">My Support Tickets</a>.</p>
                            <p style="margin-top: 24px; color: #64748B; font-size: 13px;">Best regards,<br/><strong t-out="object.company_id.name">Company Support</strong></p>
                        </div>
                    </div>
                </div>
            </field>
        </record>

        <!-- 2. Ticket Assignment Notification (to Assigned Agent) -->
        <record id="mail_template_ticket_assigned" model="mail.template">
            <field name="name">HelpDeskPro: Ticket Assigned to Agent</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">[{{ object.name }}] Assigned to You: {{ object.subject }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="description">Sent to the support agent when a ticket is assigned to them.</field>
            <field name="body_html" type="html">
                <div style="font-family: Inter, Arial, sans-serif; color: #1E293B; padding: 16px;">
                    <h3 style="color: #1E293B; margin-top: 0;">Ticket Assigned: <span t-out="object.name">HDP00001</span></h3>
                    <p>Hello <strong t-out="object.user_id.name or 'Agent'">Agent</strong>,</p>
                    <p>Support ticket <strong t-out="object.name">HDP00001</strong> (<span t-out="object.subject">Subject</span>) has been assigned to you.</p>
                    <ul>
                        <li><strong>Customer:</strong> <span t-out="object.partner_id.name or object.customer_email or 'N/A'">Customer</span></li>
                        <li><strong>Priority:</strong> <span t-out="dict(object._fields['priority'].selection).get(object.priority, '')">Medium</span></li>
                        <li><strong>SLA Resolution Deadline:</strong> <span t-out="object.sla_deadline or 'Not Set'">Deadline</span></li>
                    </ul>
                </div>
            </field>
        </record>

        <!-- 3. Ticket Resolved Notification (to Customer with CSAT Link) -->
        <record id="mail_template_ticket_resolved" model="mail.template">
            <field name="name">HelpDeskPro: Ticket Resolved Notification</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">[{{ object.name }}] Resolved: {{ object.subject }}</field>
            <field name="email_from">{{ (object.team_id.email or object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_email }}</field>
            <field name="description">Sent to the customer when their ticket is marked as Resolved.</field>
            <field name="body_html" type="html">
                <div style="font-family: Inter, Arial, sans-serif; color: #1E293B; max-width: 620px; margin: 0 auto; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
                    <div style="background-color: #16A34A; color: #FFFFFF; padding: 18px 24px;">
                        <h2 style="margin: 0; font-size: 18px;">Your Ticket Has Been Resolved</h2>
                        <p style="margin: 4px 0 0; font-size: 13px;">Reference: <strong t-out="object.name">HDP00001</strong></p>
                    </div>
                    <div style="padding: 24px; background-color: #FFFFFF;">
                        <p>Hello <strong t-out="object.partner_id.name or 'Valued Customer'">Customer</strong>,</p>
                        <p>Our support team has marked your ticket <strong t-out="object.name">HDP00001</strong> (<span t-out="object.subject">Subject</span>) as <strong>Resolved</strong>.</p>
                        <t t-if="object.resolution_summary">
                            <div style="background-color: #F0FDF4; border-left: 4px solid #16A34A; padding: 12px 16px; margin: 16px 0;">
                                <strong>Resolution Summary:</strong><br/>
                                <span t-out="object.resolution_summary">Summary</span>
                            </div>
                        </t>
                        <p>Please visit your <a t-attf-href="/my/tickets/{{ object.id }}" style="color: #2563EB; font-weight: 600;">Customer Support Portal</a> to review the solution, rate your support experience, or reopen the ticket if you need further assistance.</p>
                    </div>
                </div>
            </field>
        </record>

        <!-- 4. Overdue Ticket Reminder (Internal) -->
        <record id="mail_template_ticket_overdue" model="mail.template">
            <field name="name">HelpDeskPro: Overdue Ticket Alert</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">[OVERDUE] Ticket {{ object.name }}: {{ object.subject }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ (object.user_id.email_formatted or object.team_id.leader_id.email_formatted) }}</field>
            <field name="description">Sent by scheduled cron job when an active ticket passes its deadline.</field>
            <field name="body_html" type="html">
                <div style="font-family: Inter, Arial, sans-serif; color: #1E293B; padding: 16px; border-left: 4px solid #DC2626;">
                    <h3 style="color: #DC2626; margin-top: 0;">Overdue Ticket Reminder: <span t-out="object.name">HDP00001</span></h3>
                    <p>Ticket <strong t-out="object.name">HDP00001</strong> (<span t-out="object.subject">Subject</span>) has exceeded its target resolution deadline.</p>
                    <p>Please review and update the ticket status immediately.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
