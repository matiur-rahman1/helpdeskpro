<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. SLA Evaluation & Breach Escalation Cron (Runs every 15 minutes) -->
        <record id="ir_cron_helpdesk_sla_evaluate" model="ir.cron">
            <field name="name">HelpDeskPro: Evaluate SLA Deadlines &amp; Auto-Escalate Breaches</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_evaluate_sla_and_escalate()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Overdue Ticket Reminder Cron (Runs every 4 hours) -->
        <record id="ir_cron_helpdesk_overdue_reminders" model="ir.cron">
            <field name="name">HelpDeskPro: Send Overdue Ticket Reminders</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_reminders()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
