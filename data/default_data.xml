<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ========================================================== -->
        <!-- 1. DEFAULT SUPPORT TEAMS                                   -->
        <!-- ========================================================== -->
        <record id="team_technical_support" model="helpdesk.team">
            <field name="name">Technical Support</field>
            <field name="code">TECH</field>
            <field name="sequence">10</field>
            <field name="email">support@helpdeskpro.example.com</field>
            <field name="assignment_method">balanced</field>
            <field name="leader_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="color">4</field>
            <field name="description">Tier 1 &amp; Tier 2 technical troubleshooting, software bugs, and infrastructure issues.</field>
        </record>

        <record id="team_billing_accounts" model="helpdesk.team">
            <field name="name">Billing &amp; Account Operations</field>
            <field name="code">BILL</field>
            <field name="sequence">20</field>
            <field name="email">billing@helpdeskpro.example.com</field>
            <field name="assignment_method">balanced</field>
            <field name="leader_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="color">10</field>
            <field name="description">Invoicing, subscription renewals, refunds, payment gateway, and account access queries.</field>
        </record>

        <record id="team_customer_success" model="helpdesk.team">
            <field name="name">Customer Success &amp; Onboarding</field>
            <field name="code">CS</field>
            <field name="sequence">30</field>
            <field name="email">success@helpdeskpro.example.com</field>
            <field name="assignment_method">manual</field>
            <field name="leader_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="color">2</field>
            <field name="description">Product onboarding, installation guidance, feature requests, and general inquiries.</field>
        </record>

        <!-- ========================================================== -->
        <!-- 2. DEFAULT TICKET CATEGORIES (8 Standard Categories)       -->
        <!-- ========================================================== -->
        <record id="cat_technical_support" model="helpdesk.category">
            <field name="name">Technical Support</field>
            <field name="code">TECH</field>
            <field name="sequence">10</field>
            <field name="default_team_id" ref="team_technical_support"/>
            <field name="ai_keywords">server, api, timeout, network, connection, outage, slow, integration</field>
            <field name="description">General technical assistance, connectivity, and system troubleshooting.</field>
        </record>

        <record id="cat_software_issue" model="helpdesk.category">
            <field name="name">Software Issue</field>
            <field name="code">SW</field>
            <field name="sequence">20</field>
            <field name="default_team_id" ref="team_technical_support"/>
            <field name="ai_keywords">bug, error, crash, exception, traceback, broken, glitch, freeze</field>
            <field name="description">Application defects, crashes, unexpected behavior, and error messages.</field>
        </record>

        <record id="cat_billing" model="helpdesk.category">
            <field name="name">Billing</field>
            <field name="code">BILL</field>
            <field name="sequence">30</field>
            <field name="default_team_id" ref="team_billing_accounts"/>
            <field name="ai_keywords">invoice, payment, refund, charge, subscription, receipt, credit card, tax</field>
            <field name="description">Invoices, payment processing, overcharges, refunds, and subscription plans.</field>
        </record>

        <record id="cat_account_access" model="helpdesk.category">
            <field name="name">Account Access</field>
            <field name="code">AUTH</field>
            <field name="sequence">40</field>
            <field name="default_team_id" ref="team_billing_accounts"/>
            <field name="ai_keywords">login, password, reset, locked, 2fa, mfa, permission, access denied, sso</field>
            <field name="description">Password resets, locked accounts, SSO/2FA issues, and user permissions.</field>
        </record>

        <record id="cat_general_inquiry" model="helpdesk.category">
            <field name="name">General Inquiry</field>
            <field name="code">GEN</field>
            <field name="sequence">50</field>
            <field name="default_team_id" ref="team_customer_success"/>
            <field name="ai_keywords">question, info, hours, contact, pricing, partnership, demo</field>
            <field name="description">General product questions, documentation requests, and service inquiries.</field>
        </record>

        <record id="cat_feature_request" model="helpdesk.category">
            <field name="name">Feature Request</field>
            <field name="code">FEAT</field>
            <field name="sequence">60</field>
            <field name="default_team_id" ref="team_customer_success"/>
            <field name="ai_keywords">feature, enhancement, suggestion, roadmap, wishlist, improvement</field>
            <field name="description">Customer suggestions for new product capabilities and UX enhancements.</field>
        </record>

        <record id="cat_installation" model="helpdesk.category">
            <field name="name">Installation</field>
            <field name="code">INST</field>
            <field name="sequence">70</field>
            <field name="default_team_id" ref="team_technical_support"/>
            <field name="ai_keywords">install, setup, deploy, configure, migration, upgrade, docker, windows</field>
            <field name="description">Deployment, initial setup, environment configuration, and version upgrades.</field>
        </record>

        <record id="cat_other" model="helpdesk.category">
            <field name="name">Other</field>
            <field name="code">OTH</field>
            <field name="sequence">80</field>
            <field name="default_team_id" ref="team_customer_success"/>
            <field name="description">Miscellaneous requests not covered by other categories.</field>
        </record>

        <!-- ========================================================== -->
        <!-- 3. DEFAULT TAGS                                            -->
        <!-- ========================================================== -->
        <record id="tag_vip" model="helpdesk.tag">
            <field name="name">VIP Customer</field>
            <field name="color">1</field>
        </record>
        <record id="tag_production" model="helpdesk.tag">
            <field name="name">Production Outage</field>
            <field name="color">9</field>
        </record>
        <record id="tag_security" model="helpdesk.tag">
            <field name="name">Security</field>
            <field name="color">2</field>
        </record>
        <record id="tag_regression" model="helpdesk.tag">
            <field name="name">Regression</field>
            <field name="color">3</field>
        </record>
        <record id="tag_onboarding" model="helpdesk.tag">
            <field name="name">Onboarding</field>
            <field name="color">10</field>
        </record>

        <!-- ========================================================== -->
        <!-- 4. DEFAULT SLA POLICIES (Priority & Team Based)            -->
        <!-- ========================================================== -->
        <record id="sla_p3_urgent" model="helpdesk.sla">
            <field name="name">P1 Critical / Urgent SLA (1h Response / 4h Resolution)</field>
            <field name="sequence">1</field>
            <field name="priority">3</field>
            <field name="response_time_hours">1.0</field>
            <field name="resolution_time_hours">4.0</field>
            <field name="warning_threshold_pct">75.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="escalate_user_id" ref="base.user_admin"/>
            <field name="description">Critical SLA policy for Urgent priority incidents requiring immediate response within 1 hour and resolution within 4 hours.</field>
        </record>

        <record id="sla_p2_high" model="helpdesk.sla">
            <field name="name">P2 High Priority SLA (2h Response / 12h Resolution)</field>
            <field name="sequence">2</field>
            <field name="priority">2</field>
            <field name="response_time_hours">2.0</field>
            <field name="resolution_time_hours">12.0</field>
            <field name="warning_threshold_pct">80.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="escalate_user_id" ref="base.user_admin"/>
            <field name="description">High priority SLA with 2-hour response target and 12-hour resolution target.</field>
        </record>

        <record id="sla_p1_medium" model="helpdesk.sla">
            <field name="name">P3 Standard / Medium SLA (4h Response / 24h Resolution)</field>
            <field name="sequence">3</field>
            <field name="priority">1</field>
            <field name="response_time_hours">4.0</field>
            <field name="resolution_time_hours">24.0</field>
            <field name="warning_threshold_pct">80.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="description">Standard business SLA for Medium priority tickets.</field>
        </record>

        <record id="sla_p0_low" model="helpdesk.sla">
            <field name="name">P4 Low Priority SLA (8h Response / 48h Resolution)</field>
            <field name="sequence">4</field>
            <field name="priority">0</field>
            <field name="response_time_hours">8.0</field>
            <field name="resolution_time_hours">48.0</field>
            <field name="warning_threshold_pct">85.0</field>
            <field name="auto_escalate" eval="False"/>
            <field name="description">General inquiry and minor enhancement SLA.</field>
        </record>

        <!-- ========================================================== -->
        <!-- 5. DEFAULT KNOWLEDGE BASE CATEGORIES & ARTICLES            -->
        <!-- ========================================================== -->
        <record id="kb_cat_getting_started" model="helpdesk.knowledge.category">
            <field name="name">Getting Started &amp; Account Setup</field>
            <field name="sequence">10</field>
            <field name="icon">fa-rocket</field>
            <field name="description">Guides for account access, two-factor authentication, and initial configuration.</field>
        </record>

        <record id="kb_cat_troubleshooting" model="helpdesk.knowledge.category">
            <field name="name">Technical Troubleshooting</field>
            <field name="sequence">20</field>
            <field name="icon">fa-wrench</field>
            <field name="description">Solutions for common software errors, API connectivity, and performance optimization.</field>
        </record>

        <record id="kb_cat_billing_faq" model="helpdesk.knowledge.category">
            <field name="name">Billing, Subscriptions &amp; Invoices</field>
            <field name="sequence">30</field>
            <field name="icon">fa-credit-card</field>
            <field name="description">Answers regarding invoices, payment methods, and subscription upgrades.</field>
        </record>

        <record id="kb_art_reset_password" model="helpdesk.knowledge.article">
            <field name="name">How to Reset Your Password and Unlock Your Account</field>
            <field name="category_id" ref="kb_cat_getting_started"/>
            <field name="ticket_category_id" ref="cat_account_access"/>
            <field name="is_faq" eval="True"/>
            <field name="is_published" eval="True"/>
            <field name="keywords">password, reset, login, locked, 2fa, account access</field>
            <field name="summary">Step-by-step instructions to reset your portal password or recover a locked account.</field>
            <field name="content" type="html">
                <div>
                    <h3>1. Resetting Your Password</h3>
                    <p>Click <strong>Reset Password</strong> on the sign-in screen and enter your registered email address. You will receive a secure one-time recovery link valid for 24 hours.</p>
                    <h3>2. Unlocking After Multiple Failed Attempts</h3>
                    <p>If your account is temporarily locked due to 5 consecutive failed sign-in attempts, wait 15 minutes or submit an <strong>Account Access</strong> ticket for immediate verification.</p>
                </div>
            </field>
        </record>

        <record id="kb_art_api_timeout" model="helpdesk.knowledge.article">
            <field name="name">Resolving API Connection Timeouts and 504 Gateway Errors</field>
            <field name="category_id" ref="kb_cat_troubleshooting"/>
            <field name="ticket_category_id" ref="cat_technical_support"/>
            <field name="is_faq" eval="True"/>
            <field name="is_published" eval="True"/>
            <field name="keywords">api, timeout, 504, gateway, slow, connection, webhook</field>
            <field name="summary">Checklist for diagnosing webhook delays, firewall whitelisting, and pagination limits.</field>
            <field name="content" type="html">
                <div>
                    <h3>Common Causes of API Timeouts</h3>
                    <ul>
                        <li><strong>Unpaginated Queries:</strong> Always pass <code>limit=100</code> and <code>offset</code> parameters when fetching large datasets.</li>
                        <li><strong>Firewall Rules:</strong> Ensure outbound HTTPS traffic on port 443 is permitted.</li>
                        <li><strong>Retry Strategy:</strong> Use exponential backoff (2s, 4s, 8s) for transient network blips.</li>
                    </ul>
                </div>
            </field>
        </record>

        <record id="kb_art_invoice_download" model="helpdesk.knowledge.article">
            <field name="name">Downloading Tax Invoices, Receipts, and Updating Billing Details</field>
            <field name="category_id" ref="kb_cat_billing_faq"/>
            <field name="ticket_category_id" ref="cat_billing"/>
            <field name="is_faq" eval="True"/>
            <field name="is_published" eval="True"/>
            <field name="keywords">invoice, billing, receipt, tax, vat, refund, payment</field>
            <field name="summary">Where to download official PDF tax invoices and update your company VAT number.</field>
            <field name="content" type="html">
                <div>
                    <h3>Accessing Your Invoices</h3>
                    <p>Log in to the Customer Portal and open <strong>My Account → Invoices &amp; Bills</strong> to download PDF copies of all posted invoices and payment receipts.</p>
                    <h3>Requesting a Billing Correction</h3>
                    <p>If your company VAT/Tax ID needs to be updated on an already issued invoice, open a support ticket under the <strong>Billing</strong> category and attach your updated tax registration certificate.</p>
                </div>
            </field>
        </record>

        <!-- ========================================================== -->
        <!-- 6. INITIAL SAMPLE CUSTOMERS & TICKETS FOR LIVE ANALYTICS   -->
        <!-- ========================================================== -->
        <record id="partner_customer_acme" model="res.partner">
            <field name="name">Acme Cloud Enterprises</field>
            <field name="email">devops@acmecloud.example.com</field>
            <field name="phone">+1-555-234-5678</field>
        </record>

        <record id="partner_customer_vertex" model="res.partner">
            <field name="name">Vertex Financial Group</field>
            <field name="email">finance@vertexgroup.example.com</field>
            <field name="phone">+1-555-876-5432</field>
        </record>

        <record id="sample_ticket_api_outage" model="helpdesk.ticket">
            <field name="subject">Production Webhook API returning 504 Timeout during peak sync</field>
            <field name="partner_id" ref="partner_customer_acme"/>
            <field name="team_id" ref="team_technical_support"/>
            <field name="category_id" ref="cat_technical_support"/>
            <field name="priority">3</field>
            <field name="ticket_type">incident</field>
            <field name="source">portal</field>
            <field name="state">in_progress</field>
            <field name="tag_ids" eval="[(4, ref('tag_vip')), (4, ref('tag_production'))]"/>
            <field name="description">&lt;p&gt;Our production webhook endpoint is experiencing 504 Gateway Timeouts when syncing payloads larger than 5MB.&lt;/p&gt;</field>
        </record>

        <record id="sample_ticket_billing_invoice" model="helpdesk.ticket">
            <field name="subject">Request for revised Q4 Enterprise Tax Invoice with updated VAT ID</field>
            <field name="partner_id" ref="partner_customer_vertex"/>
            <field name="team_id" ref="team_billing_accounts"/>
            <field name="category_id" ref="cat_billing"/>
            <field name="priority">1</field>
            <field name="ticket_type">service_request</field>
            <field name="source">email</field>
            <field name="state">resolved</field>
            <field name="resolution_summary">Updated VAT registration number on customer billing profile and re-issued official tax invoice INV/2026/0042.</field>
            <field name="csat_rating">5</field>
            <field name="csat_comment">Resolved within 2 hours, thank you!</field>
        </record>

        <record id="sample_ticket_sso_access" model="helpdesk.ticket">
            <field name="subject">Two-Factor Authentication (2FA) recovery for locked department manager</field>
            <field name="partner_id" ref="partner_customer_acme"/>
            <field name="team_id" ref="team_billing_accounts"/>
            <field name="category_id" ref="cat_account_access"/>
            <field name="priority">2</field>
            <field name="ticket_type">question</field>
            <field name="source">portal</field>
            <field name="state">open</field>
            <field name="tag_ids" eval="[(4, ref('tag_security'))]"/>
        </record>

        <record id="sample_ticket_feature_export" model="helpdesk.ticket">
            <field name="subject">Add scheduled weekly CSV export for department ticket metrics</field>
            <field name="partner_id" ref="partner_customer_vertex"/>
            <field name="team_id" ref="team_customer_success"/>
            <field name="category_id" ref="cat_feature_request"/>
            <field name="priority">0</field>
            <field name="ticket_type">service_request</field>
            <field name="source">web</field>
            <field name="state">new</field>
        </record>
    </data>
</odoo>
